---
import Card from "@components/Card.astro";
import Layout from "@layouts/Layout.astro";
import datas from "../../datas.json";
---

<Layout>
  <div class="cards" aria-label="Frise chronologique des époques">
    {
      datas.eras.map((era) => (
        <Card
          era={{
            ...era,
            start_year: Number(era.start_year),
            end_year: Number(era.end_year),
          }}
          assets={datas.assets.map((asset) => ({
            title: asset.name,
            description: asset.comment,
            type: asset.type,
          }))}
        />
      ))
    }
  </div>
</Layout>

<style>
  .cards {
    display: flex;
    align-items: stretch;
    gap: 18px;
    width: 100%;
    padding: 0 max(32px, calc((100vw - 1480px) / 2));
    overflow-x: auto;
    overflow-y: hidden;
    flex-grow: 1;
    scroll-snap-type: x mandatory;
    scrollbar-color: #b7c4b8 transparent;
    scrollbar-width: thin;
    overscroll-behavior-inline: contain;
  }

  .cards::-webkit-scrollbar {
    height: 6px;
  }

  .cards::-webkit-scrollbar-thumb {
    border-radius: 99px;
    background: #b7c4b8;
  }

  .cards :global(section) {
    scroll-snap-align: start;
  }

  @media (max-width: 760px) {
    .cards {
      gap: 13px;
      padding-inline: 18px;
      padding-bottom: 12px;
    }
  }
</style>

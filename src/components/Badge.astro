---
import Tooltip from "./Tooltip.astro";
const { content, type, size } = Astro.props;
const cssClass = type?.css ?? "";
---

<Tooltip content={content.description}>
  <div class={`badge ${cssClass} ${size ?? ""}`}>
    <h3>{content.title}</h3>
  </div>
</Tooltip>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    margin: 0;
    border: 1px solid #d2ded6;
    padding: 5px 10px;
    color: #315b4b;
    border-radius: 5px;
    background: #f3f7f2;
  }

  .badge h3 {
    margin: 0;
    font-weight: 600;
    font-size: 13px;
    line-height: 1.3;
  }

  .small h3 {
    font-size: 13px;
    font-weight: 600;
  }

  .orange {
    border-color: #ead5b4;
    background: #fbf4e8;
    color: #94601e;
  }

  .red {
    border-color: #e8cbc4;
    background: #fbefec;
    color: #a64f41;
  }

  .green {
    border-color: #cbded1;
    background: #edf5ef;
    color: #376f57;
  }

  .slashed {
    text-decoration: line-through;
  }
</style>

---
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Asset {
  title: string;
  description: string;
  coming: boolean;
  type: "progress" | "phenomenom";
}

interface Bonus {
  title: string;
  description: string;
}

interface Era {
  name: string;
  slug: string;
  description: string;
  bonuses: Bonus[];
  start_year: number;
  end_year: number;
  comments: { asset: string; coming: boolean }[];
}

interface Props {
  era: Era;
  assets: Asset[];
}

const { era, assets } = Astro.props;

// Image background for the era hero section
const backgrounds = import.meta.glob<ImageMetadata>("@images/era/hero/*.png", {
  eager: true,
  import: "default",
});
const background = Object.entries(backgrounds).find(([path]) =>
  path.endsWith(`/${era.slug}.png`),
)?.[1];
if (!background) {
  throw new Error(`Missing hero image for era: ${era.slug}`);
}

// Define the type for the asset badges
const comment_assets = era.comments.map((comment) => comment.asset);
// Rules about type :
// - If an asset is mentioned in the era comments, and the asset is a "progress", its type should be "green".
// - If an asset is mentioned in the era comments, and the asset is a "phenomenom", its type should be "red".
// - If an asset is mentioned in the era comments, and the asset is a "progress" and comment is coming:true, its type should be "orange".
// - If an asset is not mentioned in the era comments, and the asset is a "phenomenom", its type should be "green slashed".
// - If an asset is not mentioned in the era comments, its type should be "red".

function type(asset: Asset) {
  if (comment_assets.includes(asset.title)) {
    if (
      asset.type === "progress" &&
      era.comments.find((comment) => comment.asset === asset.title)?.coming
    ) {
      return { css: "orange" };
    }
    if (asset.type === "progress") {
      return { css: "green" };
    }
    if (asset.type === "phenomenom") {
      return { css: "red" };
    }
  } else if (asset.type === "phenomenom") {
    return { css: "green" };
  }
  return { css: "red" };
}
---

<section id="period-section-{era.slug}">
  <div
    class="illustration"
    style={{
      backgroundImage: `url(${background.src})`,
    }}
  >
  </div>
  <div class="content">
    <div class="intro">
      <p>Vivre à l'époque de</p>
      <p class="date">
        {era.start_year < 0 ? `${Math.abs(era.start_year)} av. J.-C.` : era.start_year}
        <span aria-hidden="true">—</span>
        {era.end_year}
      </p>
    </div>
    <h2>{era.name}</h2>
    <p class="description">{era.description}</p>
    <div class="bonuses">
      <h3 class="group-label">Contexte de l'époque</h3>
      {era.bonuses.map((bonus) => <Badge content={bonus} />)}
    </div>
    <div class="assets">
      <h3 class="group-label">Évolutions et réalités</h3>
      {
        assets.map((asset) => (
          <Badge content={asset} type={type(asset)} size="small" />
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: 34% minmax(0, 1fr);
    width: clamp(760px, 74vw, 1080px);
    min-width: clamp(760px, 74vw, 1080px);
    height: min(70svh, 660px);
    min-height: 520px;
    overflow: hidden;
    border: 1px solid #e5e4dc;
    border-radius: 8px;
    background: #fffefa;
    box-shadow: 0 12px 34px #26382d12, 0 2px 5px #26382d08;
  }

  .illustration {
    min-width: 0;
    height: 100%;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .illustration::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #172c2310 45%, #172c2360);
    content: "";
  }

  .intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: 0 0 12px;
    color: #a25d47;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.02em;

    p {
      margin: 0;
    }
  }

  .date {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #68756e;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .bonuses,
  .assets {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 22px;
  }

  .group-label {
    flex-basis: 100%;
    margin: 0 0 2px;
    color: #66736b;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .content {
    min-width: 0;
    padding: clamp(23px, 3vw, 38px);
    overflow-y: auto;
    scrollbar-color: #ccd4ca transparent;
    scrollbar-width: thin;
  }

  h2 {
    margin: 0;
    color: #24362f;
    font-family: "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    line-height: 1.04;
    overflow-wrap: anywhere;
  }

  .description {
    margin: 14px 0 0;
    color: #59665f;
    font-size: 13px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    section {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 190px minmax(0, 1fr);
      width: min(88vw, 480px);
      min-width: min(88vw, 480px);
      height: min(70svh, 620px);
      min-height: 540px;
    }

    .content {
      padding: 22px;
    }

    .intro {
      margin-bottom: 10px;
      font-size: 10px;
    }

    h2 {
      font-size: 34px;
    }

    .description {
      margin-top: 10px;
      font-size: 12px;
      line-height: 1.6;
    }

    .bonuses,
    .assets {
      margin-top: 18px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    section {
      animation: card-arrive 450ms both;
    }

    @keyframes card-arrive {
      from {
        opacity: 0.75;
        transform: translateY(7px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

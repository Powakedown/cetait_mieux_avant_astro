---
import type { ImageMetadata } from "astro";
import Badge from "./Badge.astro";

interface Asset {
  title: string;
  description: string;
  coming: boolean;
  type: "progress" | "phenomenom";
}

interface Bonus {
  title: string;
  description: string;
}

interface Era {
  name: string;
  slug: string;
  description: string;
  bonuses: Bonus[];
  start_year: number;
  end_year: number;
  comments: { asset: string; coming: boolean }[];
}

interface Props {
  era: Era;
  assets: Asset[];
}

const { era, assets } = Astro.props;

// Image background for the era hero section
const backgrounds = import.meta.glob<ImageMetadata>("@images/era/hero/*.png", {
  eager: true,
  import: "default",
});
const background = Object.entries(backgrounds).find(([path]) =>
  path.endsWith(`/${era.slug}.png`),
)?.[1];
if (!background) {
  throw new Error(`Missing hero image for era: ${era.slug}`);
}

// Define the type for the asset badges
const comment_assets = era.comments.map((comment) => comment.asset);
// Rules about type :
// - If an asset is mentioned in the era comments, and the asset is a "progress", its type should be "green".
// - If an asset is mentioned in the era comments, and the asset is a "phenomenom", its type should be "red".
// - If an asset is mentioned in the era comments, and the asset is a "progress" and comment is coming:true, its type should be "orange".
// - If an asset is not mentioned in the era comments, and the asset is a "phenomenom", its type should be "green slashed".
// - If an asset is not mentioned in the era comments, its type should be "red".

function type(asset: Asset) {
  if (comment_assets.includes(asset.title)) {
    if (
      asset.type === "progress" &&
      era.comments.find((comment) => comment.asset === asset.title)?.coming
    ) {
      return { css: "orange" };
    }
    if (asset.type === "progress") {
      return { css: "green" };
    }
    if (asset.type === "phenomenom") {
      return { css: "red" };
    }
  } else if (asset.type === "phenomenom") {
    return { css: "green" };
  }
  return { css: "red" };
}
---

<section id="period-section-{era.slug}">
  <div
    class="illustration"
    style={{
      backgroundImage: `url(${background.src})`,
    }}
  >
  </div>
  <div class="content">
    <div class="intro">
      <p>
      Vivre à l'époque de
      </p>
      <p class="date">{era.start_year} - {era.end_year}</p>
    </div>
    <h1>{era.name}</h1>
    <p>{era.description}</p>
    <div class="bonuses">
      <span class="period-label">Période de :</span>
      {era.bonuses.map((bonus) => <Badge content={bonus} />)}
    </div>
    <div class="assets">
      {
        assets.map((asset) => (
          <Badge content={asset} type={type(asset)} size="small" />
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    background-color: #f2e3cf;
    box-shadow: 0 0.5rem 1rem #00000026;
    border-radius: 1rem;
    width: 55%;
    min-width: 55%;
    height: 100%;
    font-family: Verdana;
  }
  .illustration {
    width: 30%;
    height: 100%;
    float: left;
    border-radius: 1rem 0 0 1rem;
    background-size: cover;
  }
  .intro {
    margin-top: 0.5rem;
    margin-bottom: -0.5rem;
    color: #af8b5b;
    display: flex;
    justify-content: space-between;
    align-items: center;

    p {
      margin: 0;
    }
  }
  .bonuses,
  .assets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 4rem;
  }
  .content {
    margin-left: 30%;
    padding: 1rem;
    position: relative;
  }
  h1 {
    font-size: 45px;
    margin-top: 0.25em;
    color: black;
    letter-spacing: -4px;
  }

  p {
    font-size: 16px;
    text-wrap: balance;
  }

  .date {
  }

  .period-label {
    padding: 0.3rem;
    padding-left: 0rem;
  }
</style>

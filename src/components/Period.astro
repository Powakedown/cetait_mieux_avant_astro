---
const { era } = Astro.props;
import type { ImageMetadata } from "astro";

const backgrounds = import.meta.glob<ImageMetadata>("@images/era/hero/*.png", {
  eager: true,
  import: "default",
});
const background = Object.entries(backgrounds).find(([path]) =>
  path.endsWith(`/${era.slug}.png`),
)?.[1];
if (!background) {
  throw new Error(`Missing hero image for era: ${era.slug}`);
}
---

<section id="period-section-{era.slug}">
  <div
    class="illustration"
    style={{
      backgroundImage: `url(${background.src})`,
    }}
  >
  </div>
  <div class="content">
    <h1>{era.name}</h1>
    <p>{era.description}</p>
  </div>
</section>

<style>
  section {
    background-color: #f2e3cf;
    box-shadow: 0 0.5rem 1rem #00000026;
    padding: 1rem;
    border-radius: 1rem;
    width: 65%;
    min-width: 65%;
    height: 100%;
  }

  .illustration {
    width: 30%;
    height: 100%;
    float: left;
    background-size: cover;
  }

  .content {
    margin-left: 30%;
    width: 70%;
  }
  h1 {
    font-size: 22px;
    margin-top: 0.25em;
    color: black;
  }

  p {
    font-size: 16px;
  }
</style>
